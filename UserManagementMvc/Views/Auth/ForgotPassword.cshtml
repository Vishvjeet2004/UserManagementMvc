@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 550px;">

        <h2 class="text-center fw-bold">Forgot Password</h2>
        <hr />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="UserAuth" asp-action="ForgotPassword" method="post" autocomplete="off">
            <div class="mb-3">
                <label>Username / Email / Mobile</label>
                <input name="LoginId"
                       class="form-control"
                       placeholder="Enter username, email or mobile"
                       autocomplete="off" />
            </div>

            <button type="submit" class="btn btn-primary">Search Account</button>

            <a asp-controller="UserAuth" asp-action="Login" class="btn btn-secondary">
                Back to Login
            </a>
        </form>

    </div>
</div>