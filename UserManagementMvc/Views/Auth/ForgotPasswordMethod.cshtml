@model UserManagementMvc.ViewModels.ForgotPasswordMethodViewModel

@{
    ViewData["Title"] = "Password Recovery";
}

<div class="container mt-5">

    <div class="mx-auto" style="max-width: 750px;">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <!-- PAGE TITLE -->

                <h2 class="text-center fw-bold">
                    Password Recovery
                </h2>

                <p class="text-muted text-center">
                    Choose how you would like to verify your identity.
                </p>

                <hr />


                <!-- ERROR MESSAGE -->
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }


                <!-- SUCCESS MESSAGE -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }


                <div class="row g-4">



                    <!-- SECURITY QUESTIONS -->


                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100 text-center">

                            <h4 class="fw-bold">
                                Security Questions
                            </h4>

                            <p class="text-muted">
                                Verify your identity by answering
                                your saved security questions.
                            </p>

                            <form asp-controller="UserAuth"
                                  asp-action="SelectForgotPasswordMethod"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input asp-for="UserId"
                                       type="hidden" />

                                <input type="hidden"
                                       name="Method"
                                       value="SecurityQuestion" />

                                <button type="submit"
                                        class="btn btn-outline-dark w-100">

                                    Use Security Questions

                                </button>

                            </form>

                        </div>

                    </div>




                    <!-- EMAIL OTP -->


                    <div class="col-md-6">

                        <div class="border rounded p-4 h-100 text-center">

                            <h4 class="fw-bold">
                                Email OTP
                            </h4>

                            <p class="text-muted mb-1">
                                Send a 6-digit verification code to:
                            </p>

                            <p class="fw-bold mb-3">
                                @Model.MaskedEmail
                            </p>


                            <!--
                                IMPORTANT:
                                This button does NOT directly send OTP.
                                It first opens the confirmation modal.
                            -->

                            <button type="button"
                                    class="btn btn-dark w-100"
                                    data-bs-toggle="modal"
                                    data-bs-target="#emailOtpConfirmModal">

                                Send OTP

                            </button>

                        </div>

                    </div>

                </div>




                <!-- BACK BUTTON -->


                <div class="text-center mt-4">

                    <a asp-controller="UserAuth"
                       asp-action="ForgotPassword"
                       class="btn btn-secondary">

                        Back

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>




<!-- EMAIL OTP CONFIRMATION MODAL -->


<div class="modal fade"
     id="emailOtpConfirmModal"
     tabindex="-1"
     aria-labelledby="emailOtpConfirmModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">


            <!-- MODAL HEADER -->

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="emailOtpConfirmModalLabel">

                    Confirm Email Address

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>



            <!-- MODAL BODY -->

            <div class="modal-body text-center p-4">

                <p class="mb-3">

                    A 6-digit verification OTP will be sent to:

                </p>


                <!-- MASKED EMAIL -->

                <div class="alert alert-light border">

                    <strong>
                        @Model.MaskedEmail
                    </strong>

                </div>


                <p class="text-muted mb-0">

                    Is this your registered email address?

                </p>

            </div>



            <!-- MODAL FOOTER -->

            <div class="modal-footer justify-content-center">


                <!-- NO BUTTON -->


                <button type="button"
                        class="btn btn-outline-danger"
                        data-bs-dismiss="modal"
                        data-bs-toggle="modal"
                        data-bs-target="#emailNotRecognizedModal">

                    No, This Isn't My Email

                </button>




                <!-- YES BUTTON -->


                <form asp-controller="UserAuth"
                      asp-action="SelectForgotPasswordMethod"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="UserId"
                           type="hidden" />

                    <input type="hidden"
                           name="Method"
                           value="Otp" />

                    <button type="submit"
                            class="btn btn-dark">

                        Yes, Send OTP

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>




<!-- EMAIL NOT RECOGNIZED MODAL -->


<div class="modal fade"
     id="emailNotRecognizedModal"
     tabindex="-1"
     aria-labelledby="emailNotRecognizedModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">



            <!-- RED HEADER -->


            <div class="modal-header bg-danger text-white">

                <h5 class="modal-title fw-bold"
                    id="emailNotRecognizedModalLabel">

                    Email Address Not Recognized

                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>




            <!-- MESSAGE BODY -->


            <div class="modal-body text-center p-4">


                <!-- WARNING ICON -->

                <div class="mb-3">

                    <div class="mx-auto rounded-circle
                        d-flex
                        align-items-center
                        justify-content-center"
                         style="
                        width:60px;
                        height:60px;
                        background:#f8d7da;
                        ">

                        <span class="text-danger fw-bold"
                              style="font-size:28px;">

                            !

                        </span>

                    </div>

                </div>



                <!-- TITLE -->

                <h5 class="fw-bold text-danger mb-3">

                    Email Address Not Recognized

                </h5>




              
               
                <!-- ADMIN MESSAGE -->

                <p class="text-muted mb-0">

                    Please contact your
                    <strong>Administrator</strong>
                    or
                    <strong>Super Admin</strong>
                    for assistance with account recovery.

                </p>

            </div>




            <!-- OK BUTTON -->

            <div class="modal-footer justify-content-center">

                <button type="button"
                        class="btn btn-danger px-4"
                        data-bs-dismiss="modal">

                    OK

                </button>

            </div>

        </div>

    </div>

</div>




<!-- VALIDATION SCRIPTS -->

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}