@{
    ViewData["Title"] = "Verify Security Questions";

    int userId = ViewBag.UserId != null ? Convert.ToInt32(ViewBag.UserId) : 0;
    var currentQuestions = ViewBag.CurrentSecurityQuestions as List<string>;
}

<div class="container mt-5">
    <div class="mx-auto" style="max-width: 650px;">

        <h2 class="text-center fw-bold">Verify Security Questions</h2>
        <hr />

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="UserAuth" asp-action="ResetPassword" method="post" autocomplete="off">

            <input type="hidden" name="UserId" value="@userId" />

            @if (currentQuestions != null && currentQuestions.Count > 0)
            {
                for (int i = 0; i < currentQuestions.Count; i++)
                {
                    <div class="border rounded p-3 mb-3">
                        <label>@(i + 1). @currentQuestions[i]</label>

                        <input name="SecurityQuestions[@i].Answer"
                               class="form-control mt-2"
                               placeholder="Enter answer"
                               autocomplete="off" />
                    </div>
                }
            }
            else
            {
                <div class="border rounded p-3 mb-3">
                    <label>Security Answer</label>

                    <input name="SecurityQuestions[0].Answer"
                           class="form-control mt-2"
                           placeholder="Enter answer"
                           autocomplete="off" />
                </div>
            }

            <hr />

            <div class="mb-3">
                <label>New Password</label>
                <input name="NewPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            <div class="mb-3">
                <label>Confirm Password</label>
                <input name="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
            </div>

            <button type="submit" class="btn btn-success">Reset Password</button>

            <a asp-controller="UserAuth" asp-action="Login" class="btn btn-secondary">
                Back to Login
            </a>
        </form>

    </div>
</div>