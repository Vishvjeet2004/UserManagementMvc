@model UserManagementMvc.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-5">

    <div class="mx-auto" style="max-width: 500px;">

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <h2 class="text-center fw-bold">
                    Verify OTP
                </h2>

                <p class="text-muted text-center">
                    We sent a 6-digit OTP to your registered email address.
                </p>

                <hr />

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                @* OTP verify form *@
                <form asp-controller="EmailOtp"
                      asp-action="Verify"
                      method="post"
                      autocomplete="off">

                    @Html.AntiForgeryToken()

                    <input asp-for="UserId"
                           type="hidden" />

                    <input asp-for="Purpose"
                           type="hidden" />

                    <div class="mb-3">

                        <label asp-for="Otp"
                               class="form-label">
                            Enter OTP
                        </label>

                        <input asp-for="Otp"
                               class="form-control text-center"
                               maxlength="6"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               placeholder="000000" />

                        <span asp-validation-for="Otp"
                              class="text-danger">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn btn-dark w-100">
                        Verify OTP
                    </button>

                </form>

                @* Naya OTP bhejne ke liye *@
                <form asp-controller="EmailOtp"
                      asp-action="Resend"
                      method="post"
                      class="mt-3">

                    @Html.AntiForgeryToken()

                    <input asp-for="UserId"
                           type="hidden" />

                    <input asp-for="Purpose"
                           type="hidden" />

                    <button type="submit"
                            class="btn btn-outline-secondary w-100">
                        Resend OTP
                    </button>

                </form>

                <div class="text-center mt-3">

                    <a asp-controller="UserAuth"
                       asp-action="Login"
                       class="text-decoration-none">
                        Back to Login
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}