@model List<UserManagementMvc.Models.ChatEmoji>

@{
    ViewData["Title"] = "Emoji Management";
}

<link rel="stylesheet"
      href="~/css/Emoji Management.css"
      asp-append-version="true" />

<div class="emoji-management-page">

    <div class="emoji-management-header">
        <div>
            <h2>Emoji Management</h2>
            <p>Manage the emojis available in Messenger.</p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="emoji-management-card">

        <div class="emoji-management-card-header">
            <div>
                <h4>Add Emoji</h4>
                <p>Add a new emoji to Messenger.</p>
            </div>
        </div>

        <form id="addEmojiForm">

            @Html.AntiForgeryToken()

            <div class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="emojiInput" class="form-label">
                        Emoji
                    </label>

                    <input type="text"
                           id="emojiInput"
                           name="emoji"
                           class="form-control emoji-input"
                           placeholder="Enter emoji"
                           maxlength="20"
                           autocomplete="off" />
                </div>

                <div class="col-md-4">
                    <label for="sortOrderInput" class="form-label">
                        Sort Order
                    </label>

                    <input type="number"
                           id="sortOrderInput"
                           name="sortOrder"
                           class="form-control"
                           value="0"
                           min="0" />
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            id="addEmojiButton"
                            class="btn btn-primary w-100">
                        Add Emoji
                    </button>
                </div>

            </div>

        </form>

        <div id="emojiMessage"
             class="mt-3"
             style="display:none;">
        </div>

    </div>

    <div class="emoji-management-card">

        <div class="emoji-management-card-header">

            <div>
                <h4>Emoji List</h4>
                <p>Enable, disable or delete Messenger emojis.</p>
            </div>

            <span class="emoji-count-badge"
                  id="emojiCount">
                @Model.Count
            </span>

        </div>

        <div class="table-responsive">

            <table class="table align-middle emoji-management-table">

                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th style="width:120px;">Emoji</th>
                        <th>Sort Order</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="emojiTableBody">

                    @if (Model.Count == 0)
                    {
                        <tr id="emptyEmojiRow">
                            <td colspan="5"
                                class="text-center py-5">

                                <div class="emoji-empty-state">
                                    <div class="emoji-empty-icon">
                                        😊
                                    </div>

                                    <h5>
                                        No emojis available
                                    </h5>

                                    <p>
                                        Add your first emoji above.
                                    </p>
                                </div>

                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var emoji in Model)
                        {
                            <tr id="emoji-row-@emoji.Id">

                                <td>
                                    @emoji.Id
                                </td>

                                <td>
                                    <span class="emoji-preview">
                                        @emoji.Emoji
                                    </span>
                                </td>

                                <td>
                                    @emoji.SortOrder
                                </td>

                                <td>

                                    @if (emoji.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-sm @(emoji.IsActive ? "btn-warning" : "btn-success") toggle-emoji-button"
                                            data-id="@emoji.Id">

                                        @(emoji.IsActive ? "Disable" : "Enable")

                                    </button>

                                    <button type="button"
                                            class="btn btn-sm btn-danger delete-emoji-button"
                                            data-id="@emoji.Id">

                                        Delete

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const addEmojiForm =
            document.getElementById("addEmojiForm");

        const emojiInput =
            document.getElementById("emojiInput");

        const sortOrderInput =
            document.getElementById("sortOrderInput");

        const addEmojiButton =
            document.getElementById("addEmojiButton");

        const emojiMessage =
            document.getElementById("emojiMessage");

        const emojiTableBody =
            document.getElementById("emojiTableBody");

        const emojiCount =
            document.getElementById("emojiCount");

        function getToken() {
            const token =
                document.querySelector(
                    '#addEmojiForm input[name="__RequestVerificationToken"]'
                );

            return token ? token.value : "";
        }

        function showMessage(message, success) {

            emojiMessage.textContent = message;

            emojiMessage.className =
                success
                    ? "alert alert-success mt-3"
                    : "alert alert-danger mt-3";

            emojiMessage.style.display = "block";

            setTimeout(function () {
                emojiMessage.style.display = "none";
            }, 3000);
        }

        function updateCount() {

            const rows =
                emojiTableBody.querySelectorAll(
                    "tr[data-emoji-row='true']"
                );

            emojiCount.textContent = rows.length;
        }

        function removeEmptyRow() {

            const emptyRow =
                document.getElementById("emptyEmojiRow");

            if (emptyRow) {
                emptyRow.remove();
            }
        }

        function showEmptyRow() {

            const rows =
                emojiTableBody.querySelectorAll(
                    "tr[data-emoji-row='true']"
                );

            if (rows.length > 0) {
                return;
            }

            if (document.getElementById("emptyEmojiRow")) {
                return;
            }

            const row =
                document.createElement("tr");

            row.id = "emptyEmojiRow";

            row.innerHTML = `
                    <td colspan="5" class="text-center py-5">
                        <div class="emoji-empty-state">
                            <div class="emoji-empty-icon">😊</div>
                            <h5>No emojis available</h5>
                            <p>Add your first emoji above.</p>
                        </div>
                    </td>
                `;

            emojiTableBody.appendChild(row);
        }

        addEmojiForm.addEventListener(
            "submit",
            async function (event) {

                event.preventDefault();

                const emoji =
                    emojiInput.value.trim();

                const sortOrder =
                    parseInt(
                        sortOrderInput.value || "0",
                        10
                    );

                if (!emoji) {
                    showMessage(
                        "Please enter an emoji.",
                        false
                    );

                    emojiInput.focus();

                    return;
                }

                addEmojiButton.disabled = true;

                try {

                    const formData =
                        new FormData();

                    formData.append(
                        "emoji",
                        emoji
                    );

                    formData.append(
                        "sortOrder",
                        sortOrder
                    );

                    formData.append(
                        "__RequestVerificationToken",
                        getToken()
                    );

                    const response =
                        await fetch(
                            "/EmojiManagement/AddEmoji",
                            {
                                method: "POST",
                                body: formData
                            }
                        );

                    const result =
                        await response.json();

                    if (!result.success) {

                        showMessage(
                            result.message ||
                            "Unable to add emoji.",
                            false
                        );

                        return;
                    }

                    removeEmptyRow();

                    const row =
                        document.createElement("tr");

                    row.id =
                        "emoji-row-" +
                        result.id;

                    row.setAttribute(
                        "data-emoji-row",
                        "true"
                    );

                    row.innerHTML = `
                            <td>${result.id}</td>

                            <td>
                                <span class="emoji-preview">
                                    ${escapeHtml(result.emoji)}
                                </span>
                            </td>

                            <td>${result.sortOrder}</td>

                            <td>
                                <span class="badge bg-success">
                                    Active
                                </span>
                            </td>

                            <td class="text-end">

                                <button type="button"
                                        class="btn btn-sm btn-warning toggle-emoji-button"
                                        data-id="${result.id}">
                                    Disable
                                </button>

                                <button type="button"
                                        class="btn btn-sm btn-danger delete-emoji-button"
                                        data-id="${result.id}">
                                    Delete
                                </button>

                            </td>
                        `;

                    emojiTableBody.appendChild(row);

                    emojiInput.value = "";
                    sortOrderInput.value = "0";

                    updateCount();

                    showMessage(
                        result.message ||
                        "Emoji added successfully.",
                        true
                    );

                    bindButtons();

                }
                catch (error) {

                    showMessage(
                        "An error occurred while adding the emoji.",
                        false
                    );

                }
                finally {

                    addEmojiButton.disabled = false;

                }

            }
        );

        function bindButtons() {

            document
                .querySelectorAll(".toggle-emoji-button")
                .forEach(function (button) {

                    button.onclick = async function () {

                        const id =
                            button.getAttribute("data-id");

                        button.disabled = true;

                        try {

                            const formData =
                                new FormData();

                            formData.append(
                                "id",
                                id
                            );

                            formData.append(
                                "__RequestVerificationToken",
                                getToken()
                            );

                            const response =
                                await fetch(
                                    "/EmojiManagement/ToggleEmoji",
                                    {
                                        method: "POST",
                                        body: formData
                                    }
                                );

                            const result =
                                await response.json();

                            if (!result.success) {

                                showMessage(
                                    result.message ||
                                    "Unable to update emoji.",
                                    false
                                );

                                return;
                            }

                            const row =
                                document.getElementById(
                                    "emoji-row-" + id
                                );

                            if (!row) {
                                return;
                            }

                            const statusCell =
                                row.children[3];

                            const actionCell =
                                row.children[4];

                            if (result.isActive) {

                                statusCell.innerHTML = `
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    `;

                                button.textContent =
                                    "Disable";

                                button.className =
                                    "btn btn-sm btn-warning toggle-emoji-button";

                            }
                            else {

                                statusCell.innerHTML = `
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    `;

                                button.textContent =
                                    "Enable";

                                button.className =
                                    "btn btn-sm btn-success toggle-emoji-button";

                            }

                            bindButtons();

                            showMessage(
                                "Emoji status updated.",
                                true
                            );

                        }
                        catch (error) {

                            showMessage(
                                "An error occurred while updating the emoji.",
                                false
                            );

                        }
                        finally {

                            button.disabled = false;

                        }

                    };

                });


            document
                .querySelectorAll(".delete-emoji-button")
                .forEach(function (button) {

                    button.onclick = async function () {

                        const id =
                            button.getAttribute("data-id");

                        const confirmed =
                            confirm(
                                "Are you sure you want to delete this emoji?"
                            );

                        if (!confirmed) {
                            return;
                        }

                        button.disabled = true;

                        try {

                            const formData =
                                new FormData();

                            formData.append(
                                "id",
                                id
                            );

                            formData.append(
                                "__RequestVerificationToken",
                                getToken()
                            );

                            const response =
                                await fetch(
                                    "/EmojiManagement/DeleteEmoji",
                                    {
                                        method: "POST",
                                        body: formData
                                    }
                                );

                            const result =
                                await response.json();

                            if (!result.success) {

                                showMessage(
                                    result.message ||
                                    "Unable to delete emoji.",
                                    false
                                );

                                return;
                            }

                            const row =
                                document.getElementById(
                                    "emoji-row-" + id
                                );

                            if (row) {
                                row.remove();
                            }

                            updateCount();
                            showEmptyRow();

                            showMessage(
                                result.message ||
                                "Emoji deleted successfully.",
                                true
                            );

                        }
                        catch (error) {

                            showMessage(
                                "An error occurred while deleting the emoji.",
                                false
                            );

                        }

                    };

                });

        }

        function escapeHtml(value) {

            const div =
                document.createElement("div");

            div.textContent =
                value;

            return div.innerHTML;
        }

        document
            .querySelectorAll("#emojiTableBody > tr")
            .forEach(function (row) {

                if (row.id !== "emptyEmojiRow") {

                    row.setAttribute(
                        "data-emoji-row",
                        "true"
                    );

                }

            });

        bindButtons();
        updateCount();

    });
</script>