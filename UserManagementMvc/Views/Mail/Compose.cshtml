@model UserManagementMvc.ViewModels.MailComposeViewModel

@using System.Text.Json
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Compose Mail";

    var allowedExtensions =
        ".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip";

    var serializedTools =
        JsonSerializer.Serialize(
            Model.Tools?
                .Where(x => x.IsEnabled)
                .OrderBy(x => x.DisplayOrder)
                .Select(x => x.ToolKey)
            ?? Enumerable.Empty<string>());

    var serializedSignatures =
        JsonSerializer.Serialize(
            Model.Signatures?.Select(x => new
            {
                id = x.Id,
                name = x.Name,
                html = x.SignatureHtml,
                isDefault = x.IsDefault
            })
            ?? Enumerable.Empty<object>(),
            new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.Default
            });
}

<style>
    .mail-compose-page {
        width: 100%;
        height: calc(100vh - 72px);
        min-height: 560px;
        padding: 18px;
        box-sizing: border-box;
        background: #f5f7fb;
    }

    .mail-compose-card {
        width: 100%;
        max-width: 1180px;
        height: 100%;
        min-height: 0;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #e1e5ea;
        border-radius: 10px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .mail-compose-header {
        flex: 0 0 auto;
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0 20px;
        background: #f1f5fb;
        border-bottom: 1px solid #e3e7ed;
    }

    .mail-compose-header h1 {
        margin: 0;
        color: #202124;
        font-size: 17px;
        font-weight: 500;
        line-height: 44px;
    }

    .mail-compose-subtitle {
        display: none;
    }

    .mail-compose-close {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #4b5563;
        font-size: 23px;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
    }

    .mail-compose-close:hover {
        background: #e5e7eb;
        color: #111827;
    }

    .mail-compose-form {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
        overflow: hidden;
    }

    .mail-validation-summary {
        flex: 0 0 auto;
        margin: 8px 20px 0;
        padding: 7px 10px;
        border-radius: 6px;
        background: #fff4f4;
        color: #b42318;
        font-size: 13px;
    }

    .mail-validation-summary:empty {
        display: none;
    }

    .mail-recipient-row {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 8px 20px 0;
        box-sizing: border-box;
    }

    .mail-field {
        flex: 0 0 auto;
        width: 100%;
        margin: 0;
    }

    .mail-recipient-row .mail-field-main {
        flex: 1 1 auto;
        min-width: 0;
    }

    .mail-field label {
        display: none;
    }

    .mail-input {
        display: block;
        width: 100%;
        min-height: 42px;
        padding: 8px 0;
        box-sizing: border-box;
        border: 0;
        border-bottom: 1px solid #e1e5ea;
        border-radius: 0;
        outline: none;
        background: #ffffff;
        color: #202124;
        font-family: inherit;
        font-size: 15px;
    }

    .mail-input:hover {
        border-bottom-color: #c5cbd3;
    }

    .mail-input:focus {
        border-bottom-color: #2563eb;
        box-shadow: none;
    }

    .mail-input::placeholder {
        color: #6b7280;
    }

    .mail-recipient-actions {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .mail-small-button {
        min-width: 42px;
        min-height: 32px;
        padding: 4px 8px;
        border: 0;
        border-radius: 5px;
        background: transparent;
        color: #5f6368;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
    }

    .mail-small-button:hover {
        background: #f1f3f4;
        color: #202124;
    }

    .mail-hidden-field {
        display: none;
        flex: 0 0 auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .mail-hidden-field.is-visible {
        display: block;
    }

    .mail-hidden-field .mail-input {
        min-height: 40px;
    }

    .mail-field-error {
        display: block;
        margin-top: 3px;
        color: #dc2626;
        font-size: 12px;
    }

    .mail-compose-form > .mail-field {
        flex: 0 0 auto;
        padding: 0 20px;
        box-sizing: border-box;
    }

    .mail-compose-form > .mail-field .mail-input {
        min-height: 42px;
    }

    .mail-editor-panel {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        margin-top: 0;
        display: flex;
        flex-direction: column;
        overflow: visible;
    }

    .mail-editor-wrapper {
        order: 1;
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    .mail-editor {
        flex: 1 1 auto;
        width: 100%;
        min-height: 180px;
        max-height: none;
        padding: 14px 20px;
        box-sizing: border-box;
        overflow-y: auto;
        overflow-x: hidden;
        border: 0;
        border-top: 1px solid #e1e5ea;
        border-bottom: 0;
        border-radius: 0;
        outline: none;
        background: #ffffff;
        color: #202124;
        font-family: Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
    }

    .mail-editor:focus {
        border-color: #e1e5ea;
        box-shadow: none;
    }

    .mail-editor:empty::before {
        content: attr(data-placeholder);
        color: #9ca3af;
        pointer-events: none;
    }

    .mail-editor img {
        max-width: 100%;
        height: auto;
    }

    .mail-editor a {
        color: #2563eb;
    }

    .mail-editor blockquote {
        margin: 10px 0;
        padding-left: 12px;
        border-left: 3px solid #d1d5db;
        color: #6b7280;
    }

    .mail-body-field {
        position: absolute;
        left: -99999px;
        top: -99999px;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .mail-editor-panel > .mail-field-error {
        order: 3;
        flex: 0 0 auto;
        padding: 0 20px;
    }

    .mail-toolbar {
        order: 2;
        flex: 0 0 auto;
        width: 100%;
        min-height: 50px;
        display: flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 0;
        padding: 7px 10px;
        box-sizing: border-box;
        border: 0;
        border-top: 1px solid #e1e5ea;
        border-bottom: 1px solid #e1e5ea;
        border-radius: 0;
        background: #eef3fb;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
    }

    .mail-toolbar::-webkit-scrollbar {
        height: 5px;
    }

    .mail-toolbar-button {
        flex: 0 0 auto;
        min-width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 5px 8px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #4b5563;
        font-family: inherit;
        font-size: 13px;
        font-weight: 500;
        line-height: 1;
        white-space: nowrap;
        cursor: pointer;
        transition: background 0.15s ease;
    }

    .mail-toolbar-button:hover {
        background: #dfe7f3;
        color: #202124;
    }

    .mail-toolbar-button:active {
        background: #d5dfed;
    }

    .mail-toolbar-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        color: #4b5563;
        font-size: 17px;
        line-height: 1;
    }

    .mail-toolbar-label {
        display: inline-block;
        max-width: 90px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tool-icon-bold {
        font-weight: 900;
    }

    .tool-icon-italic {
        font-style: italic;
        font-weight: 700;
    }

    .tool-icon-underline {
        font-weight: 700;
        text-decoration: underline;
    }

    .tool-icon-strike {
        font-weight: 700;
        text-decoration: line-through;
    }

    .tool-icon-font {
        font-family: Georgia, serif;
        font-weight: 700;
    }

    .tool-icon-font-size {
        font-weight: 700;
    }

    .tool-icon-color {
        font-weight: 900;
        text-decoration: underline;
        text-decoration-thickness: 3px;
    }

    .tool-icon-remove-format {
        font-weight: 700;
        text-decoration: line-through;
    }

    .mail-popover {
        position: absolute;
        z-index: 99999;
        min-width: 160px;
        padding: 8px;
        border: 1px solid #d9dde3;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.14);
    }

    .mail-popover[hidden] {
        display: none !important;
    }

    .mail-popover button {
        display: block;
        width: 100%;
        margin: 0 0 5px;
        padding: 8px 10px;
        border: 1px solid #e0e3e7;
        border-radius: 6px;
        background: #ffffff;
        color: #374151;
        font-family: inherit;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
    }

    .mail-popover button:last-child {
        margin-bottom: 0;
    }

    .mail-popover button:hover {
        background: #f3f4f6;
    }

    .mail-color-popover {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-width: 150px;
    }

    .mail-color-popover button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        margin: 0;
        padding: 0;
        border-radius: 50%;
        text-align: center;
        font-size: 18px;
    }

    .mail-existing-attachments,
    .mail-attachments-panel {
        flex: 0 0 auto;
        margin: 10px 20px 0;
        padding: 10px 12px;
        border: 1px solid #e1e5ea;
        border-radius: 8px;
        background: #fafbfc;
    }

    .mail-existing-title,
    .mail-attachments-title {
        color: #202124;
        font-size: 13px;
        font-weight: 600;
    }

    .mail-existing-attachment {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 6px 0;
        color: #2563eb;
        text-decoration: none;
        border-bottom: 1px solid #f0f1f2;
    }

    .mail-existing-attachment:last-child {
        border-bottom: 0;
    }

    .mail-existing-name {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mail-existing-size {
        flex: 0 0 auto;
        color: #6b7280;
        font-size: 12px;
    }

    .mail-attachments-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .mail-attachments-subtitle {
        margin-top: 2px;
        color: #6b7280;
        font-size: 11px;
    }

    .mail-attachment-add-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 32px;
        padding: 6px 10px;
        border: 1px solid #d5d9df;
        border-radius: 7px;
        background: #ffffff;
        color: #374151;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
    }

    .mail-attachment-add-button:hover {
        background: #f1f3f4;
    }

    .mail-attachment-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .mail-attachment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        min-height: 38px;
        padding: 6px 8px;
        box-sizing: border-box;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
        background: #ffffff;
    }

    .mail-attachment-info {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
        flex: 1;
    }

    .mail-attachment-icon {
        flex: 0 0 auto;
        font-size: 17px;
    }

    .mail-attachment-name {
        min-width: 0;
        max-width: 550px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #202124;
        font-size: 13px;
    }

    .mail-attachment-size {
        flex: 0 0 auto;
        color: #6b7280;
        font-size: 11px;
    }

    .mail-attachment-remove {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        width: 28px;
        height: 28px;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #6b7280;
        font-size: 19px;
        line-height: 1;
        cursor: pointer;
    }

    .mail-attachment-remove:hover {
        background: #f1f3f4;
        color: #d93025;
    }

    .mail-attachment-empty {
        padding: 6px 0 2px;
        color: #6b7280;
        font-size: 12px;
    }

    .mail-attachment-help {
        display: block;
        margin-top: 7px;
        color: #6b7280;
        font-size: 11px;
    }

    .mail-compose-footer {
        flex: 0 0 auto;
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin: 0;
        padding: 7px 20px;
        box-sizing: border-box;
        border-top: 0;
        background: #ffffff;
    }

    .mail-footer-left {
        display: flex;
        align-items: center;
        gap: 7px;
        min-width: 0;
    }

    .mail-send-button,
    .mail-draft-button,
    .mail-cancel-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 8px 16px;
        box-sizing: border-box;
        border-radius: 20px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        line-height: 1;
        text-decoration: none;
        cursor: pointer;
    }

    .mail-send-button {
        border: 1px solid #0b57d0;
        background: #0b57d0;
        color: #ffffff;
    }

    .mail-send-button:hover {
        border-color: #0842a0;
        background: #0842a0;
        color: #ffffff;
    }

    .mail-draft-button {
        border: 1px solid #d1d5db;
        background: #ffffff;
        color: #374151;
    }

    .mail-draft-button:hover {
        background: #f3f4f6;
    }

    .mail-cancel-button {
        border: 1px solid #d1d5db;
        background: #ffffff;
        color: #374151;
    }

    .mail-cancel-button:hover {
        background: #f3f4f6;
    }

    .mail-compose-footer .mail-delete-button {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 50%;
        background: transparent;
        color: #5f6368;
        font-size: 19px;
        cursor: pointer;
    }

    .mail-compose-footer .mail-delete-button:hover {
        background: #f1f3f4;
        color: #202124;
    }

    .mail-emoji-picker {
        position: fixed !important;
        z-index: 999999 !important;
    }

    @@media (max-width: 900px) {
        .mail-compose-page {
            height: calc(100vh - 64px);
            padding: 0;
        }

        .mail-compose-card {
            max-width: none;
            border-radius: 0;
        }

        .mail-compose-form {
            padding: 0;
        }

        .mail-compose-header {
            padding: 0 14px;
        }

        .mail-recipient-row {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-compose-form > .mail-field {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-hidden-field {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-editor {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-editor-panel > .mail-field-error {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-compose-footer {
            padding-left: 14px;
            padding-right: 14px;
        }

        .mail-attachments-panel,
        .mail-existing-attachments {
            margin-left: 14px;
            margin-right: 14px;
        }
    }

    @@media (max-width: 600px) {
        .mail-toolbar {
            min-height: 48px;
            padding: 6px;
        }

        .mail-toolbar-button {
            min-width: 34px;
            height: 34px;
            padding: 4px 6px;
        }

        .mail-toolbar-label {
            display: none;
        }

        .mail-toolbar-icon {
            margin-right: 0;
        }

        .mail-compose-footer {
            min-height: 56px;
            padding: 6px 10px;
        }

        .mail-send-button {
            padding-left: 15px;
            padding-right: 15px;
        }

        .mail-draft-button,
        .mail-cancel-button {
            display: none;
        }

        .mail-footer-left {
            width: 100%;
        }

        .mail-compose-footer .mail-delete-button {
            flex: 0 0 auto;
        }
    }
</style>

<div class="mail-compose-page">

    <div class="mail-compose-card">

        <div class="mail-compose-header">
            <div>
                <h1>New Message</h1>
                <div class="mail-compose-subtitle">
                    Write and send a new message
                </div>
            </div>

            <a asp-controller="Mail"
               asp-action="Inbox"
               class="mail-compose-close"
               title="Close">
                ×
            </a>
        </div>

        <form asp-controller="Mail"
              asp-action="Compose"
              method="post"
              enctype="multipart/form-data"
              id="mailComposeForm"
              class="mail-compose-form">

            @Html.AntiForgeryToken()

            <input asp-for="DraftId"
                   type="hidden" />

            <input asp-for="ReplyToMessageId"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="mail-validation-summary">
            </div>

            <div class="mail-recipient-row">

                <div class="mail-field mail-field-main">

                    <input asp-for="RecipientEmail"
                           class="mail-input"
                           list="mailRecipients"
                           autocomplete="off"
                           placeholder="Recipients" />

                    <datalist id="mailRecipients">

                        @if (Model.Recipients != null)
                        {
                            foreach (var recipient in Model.Recipients)
                            {
                                <option value="@recipient.Email">
                                    @recipient.Name
                                </option>
                            }
                        }

                    </datalist>

                    <span asp-validation-for="RecipientEmail"
                          class="mail-field-error">
                    </span>

                </div>

                <div class="mail-recipient-actions">

                    <button type="button"
                            id="showCcButton"
                            class="mail-small-button">
                        Cc
                    </button>

                    <button type="button"
                            id="showBccButton"
                            class="mail-small-button">
                        Bcc
                    </button>

                </div>

            </div>

            <div id="ccField"
                 class="mail-field mail-hidden-field">

                <input asp-for="CcEmails"
                       class="mail-input"
                       placeholder="Cc" />

                <span asp-validation-for="CcEmails"
                      class="mail-field-error">
                </span>

            </div>

            <div id="bccField"
                 class="mail-field mail-hidden-field">

                <input asp-for="BccEmails"
                       class="mail-input"
                       placeholder="Bcc" />

                <span asp-validation-for="BccEmails"
                      class="mail-field-error">
                </span>

            </div>

            <div class="mail-field">

                <input asp-for="Subject"
                       class="mail-input"
                       maxlength="255"
                       placeholder="Subject" />

                <span asp-validation-for="Subject"
                      class="mail-field-error">
                </span>

            </div>

            <div class="mail-editor-panel">

                <div class="mail-toolbar"
                     id="mailComposeToolbar">

                    @if (Model.Tools != null &&
                         Model.Tools.Count > 0)
                    {
                        foreach (var tool in Model.Tools
                            .Where(x => x.IsEnabled)
                            .OrderBy(x => x.DisplayOrder))
                        {
                            string icon =
                                tool.ToolKey switch
                                {
                                    "undo" => "↶",
                                    "redo" => "↷",
                                    "font" => "A",
                                    "fontSize" => "A↕",
                                    "bold" => "B",
                                    "italic" => "I",
                                    "underline" => "U",
                                    "textColor" => "A",
                                    "align" => "☰",
                                    "orderedList" => "1.",
                                    "unorderedList" => "•",
                                    "outdent" => "⇤",
                                    "indent" => "⇥",
                                    "quote" => "❝",
                                    "strike" => "S",
                                    "removeFormat" => "Tx",
                                    "attachment" => "📎",
                                    "link" => "🔗",
                                    "emoji" => "😊",
                                    "image" => "🖼",
                                    "signature" => "✍",
                                    "confidential" => "🔒",
                                    _ => "•"
                                };

                            string iconClass =
                                tool.ToolKey switch
                                {
                                    "font" => "tool-icon-font",
                                    "fontSize" => "tool-icon-font-size",
                                    "bold" => "tool-icon-bold",
                                    "italic" => "tool-icon-italic",
                                    "underline" => "tool-icon-underline",
                                    "textColor" => "tool-icon-color",
                                    "strike" => "tool-icon-strike",
                                    "removeFormat" => "tool-icon-remove-format",
                                    _ => ""
                                };

                            <button type="button"
                                    class="mail-toolbar-button"
                                    data-tool="@tool.ToolKey"
                                    title="@tool.DisplayName"
                                    aria-label="@tool.DisplayName">

                                <span class="mail-toolbar-icon @iconClass">
                                    @icon
                                </span>

                                <span class="mail-toolbar-label">
                                    @tool.DisplayName
                                </span>

                            </button>
                        }
                    }

                </div>

                <div id="fontPopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-font="Arial">
                        Arial
                    </button>

                    <button type="button"
                            data-font="Verdana">
                        Verdana
                    </button>

                    <button type="button"
                            data-font="Georgia">
                        Georgia
                    </button>

                    <button type="button"
                            data-font="Times New Roman">
                        Times New Roman
                    </button>

                </div>

                <div id="fontSizePopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-size="1">
                        Small
                    </button>

                    <button type="button"
                            data-size="3">
                        Normal
                    </button>

                    <button type="button"
                            data-size="5">
                        Large
                    </button>

                    <button type="button"
                            data-size="7">
                        Huge
                    </button>

                </div>

                <div id="colorPopover"
                     class="mail-popover mail-color-popover"
                     hidden>

                    <button type="button"
                            data-color="#000000"
                            title="Black"
                            style="color:#000000;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#d32f2f"
                            title="Red"
                            style="color:#d32f2f;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#1976d2"
                            title="Blue"
                            style="color:#1976d2;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#388e3c"
                            title="Green"
                            style="color:#388e3c;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#7b1fa2"
                            title="Purple"
                            style="color:#7b1fa2;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#f57c00"
                            title="Orange"
                            style="color:#f57c00;">
                        ●
                    </button>

                </div>

                <div id="alignPopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-align="justifyLeft">
                        ← Left
                    </button>

                    <button type="button"
                            data-align="justifyCenter">
                        ↔ Center
                    </button>

                    <button type="button"
                            data-align="justifyRight">
                        → Right
                    </button>

                    <button type="button"
                            data-align="justifyFull">
                        ☰ Justify
                    </button>

                </div>

                <div class="mail-editor-wrapper">

                    <div id="mailEditor"
                         class="mail-editor"
                         contenteditable="true"
                         spellcheck="true"
                         role="textbox"
                         aria-multiline="true"
                         data-placeholder="Write your message...">@Html.Raw(Model.Body)</div>

                    <textarea asp-for="Body"
                              id="mailBodyField"
                              class="mail-body-field"></textarea>

                </div>

                <span asp-validation-for="Body"
                      class="mail-field-error">
                </span>

            </div>

            @if (Model.ExistingAttachments != null &&
                 Model.ExistingAttachments.Count > 0)
            {
                <div class="mail-existing-attachments">

                    <div class="mail-existing-title">
                        Existing attachments
                    </div>

                    @foreach (var attachment in Model.ExistingAttachments)
                    {
                        <a asp-controller="Mail"
                           asp-action="DownloadAttachment"
                           asp-route-id="@attachment.Id"
                           class="mail-existing-attachment">

                            <span>📎</span>

                            <span class="mail-existing-name">
                                @attachment.OriginalFileName
                            </span>

                            <span class="mail-existing-size">
                                @FormatFileSize(attachment.FileSize)
                            </span>

                        </a>
                    }

                </div>
            }

            <div id="mailAttachmentsPanel" class="mail-attachments-panel" hidden>

                <div class="mail-attachments-header">

                    <div>

                        <div class="mail-attachments-title">
                            Attachments
                            (<span id="mailAttachmentCount">0</span>)
                        </div>

                        <div class="mail-attachments-subtitle">
                            Add multiple files to the same email.
                        </div>

                    </div>

                    <label for="mailAttachmentInput"
                           class="mail-attachment-add-button">
                        📎 Add files
                    </label>

                </div>

                <input type="file"
                       id="mailAttachmentInput"
                       name="Attachments"
                       multiple
                       hidden
                       accept="@allowedExtensions" />

                <div id="mailAttachmentList"
                     class="mail-attachment-list">
                </div>

                <div id="mailAttachmentEmpty"
                     class="mail-attachment-empty">
                    No attachments selected.
                </div>

                <div class="mail-attachment-help">
                    Maximum 10 files per mail · Maximum 25 MB per file
                </div>

            </div>

            <div class="mail-compose-footer">

                <div class="mail-footer-left">

                    @if (Model.DraftId.HasValue)
                    {
                        <button type="submit"
                                formaction="@Url.Action("SendDraft", "Mail", new { id = Model.DraftId.Value })"
                                class="mail-send-button">
                            Send
                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="mail-send-button">
                            Send
                        </button>
                    }

                    <button type="submit"
                            formaction="@Url.Action("SaveDraft", "Mail")"
                            class="mail-draft-button">
                        Save Draft
                    </button>

                    <a asp-controller="Mail"
                       asp-action="Inbox"
                       class="mail-cancel-button">
                        Cancel
                    </a>

                </div>

                <button type="button"
                        class="mail-delete-button"
                        title="Discard draft"
                        onclick="window.location.href='@Url.Action("Inbox", "Mail")'">
                    🗑
                </button>

            </div>

        </form>

    </div>

</div>

@functions
{
    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (bytes < 1024 * 1024)
        {
            return $"{bytes / 1024d:0.##} KB";
        }

        if (bytes < 1024 * 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.##} MB";
        }

        return $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }
}

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.mailComposeConfig = {
            tools: @Html.Raw(serializedTools),
            signatures: @Html.Raw(serializedSignatures)
        };
    </script>

    <script src="~/js/mail-composer.js"
            asp-append-version="true"></script>

    <script src="~/js/mail-attachments.js"
            asp-append-version="true"></script>
}