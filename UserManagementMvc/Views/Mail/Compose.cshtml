@model UserManagementMvc.ViewModels.MailComposeViewModel

@using System.Text.Json
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Compose Mail";

    var allowedExtensions =
        ".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip";

    var serializedTools =
        JsonSerializer.Serialize(
            Model.Tools?
                .Where(x => x.IsEnabled)
                .OrderBy(x => x.DisplayOrder)
                .Select(x => x.ToolKey)
            ?? Enumerable.Empty<string>());

    var serializedSignatures =
        JsonSerializer.Serialize(
            Model.Signatures?.Select(x => new
            {
                id = x.Id,
                name = x.Name,
                html = x.SignatureHtml,
                isDefault = x.IsDefault
            })
            ?? Enumerable.Empty<object>(),
            new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.Default
            });
}

<style>

    /*
     * --------------------------------------------------
     * COMPOSE WINDOW
     * --------------------------------------------------
     */

    .mail-compose-page {
        width: 100%;
        height: calc(100vh - 70px);
        min-height: 560px;
        padding: 10px;
        box-sizing: border-box;
        background: #f5f7fb;
    }


    .mail-compose-card {
        width: 100%;
        max-width: 1200px;
        height: 100%;
        min-height: 0;
        margin: 0 auto;

        display: flex;
        flex-direction: column;

        overflow: hidden;

        background: #ffffff;

        border: 1px solid #dfe3e8;
        border-radius: 10px;

        box-shadow:
            0 4px 18px rgba(0, 0, 0, 0.08);
    }


    /*
     * --------------------------------------------------
     * HEADER
     * --------------------------------------------------
     */

    .mail-compose-header {
        flex: 0 0 auto;

        min-height: 48px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 18px;

        box-sizing: border-box;

        background: #f1f5fb;

        border-bottom: 1px solid #dfe3e8;
    }


    .mail-compose-header h1 {
        margin: 0;

        color: #202124;

        font-size: 18px;
        font-weight: 500;
    }


    .mail-compose-close {
        width: 34px;
        height: 34px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border: 0;
        border-radius: 50%;

        background: transparent;

        color: #4b5563;

        font-size: 24px;

        text-decoration: none;

        cursor: pointer;
    }


    .mail-compose-close:hover {
        background: #e5e7eb;
    }


    /*
     * --------------------------------------------------
     * FORM
     * --------------------------------------------------
     */

    .mail-compose-form {
        flex: 1 1 auto;

        min-height: 0;

        display: flex;
        flex-direction: column;

        overflow: hidden;
    }


    /*
     * --------------------------------------------------
     * VALIDATION
     * --------------------------------------------------
     */

    .mail-validation-summary {
        flex: 0 0 auto;

        margin: 6px 20px 0;
        padding: 6px 9px;

        border-radius: 6px;

        background: #fff4f4;

        color: #b42318;

        font-size: 13px;
    }


    .mail-validation-summary:empty {
        display: none;
    }


    /*
     * --------------------------------------------------
     * RECIPIENT ROW
     * --------------------------------------------------
     */

    .mail-recipient-row {
        flex: 0 0 auto;

        display: flex;
        align-items: center;

        gap: 8px;

        padding: 7px 20px 0;

        box-sizing: border-box;
    }


    .mail-field {
        flex: 0 0 auto;

        width: 100%;

        margin: 0;

        box-sizing: border-box;
    }


    .mail-field-main {
        flex: 1 1 auto;

        min-width: 0;
    }


    .mail-input {
        display: block;

        width: 100%;

        min-height: 42px;

        padding: 8px 14px;

        box-sizing: border-box;

        border: 1px solid #d5dae1;

        border-radius: 8px;

        outline: none;

        background: #ffffff;

        color: #202124;

        font-family: inherit;

        font-size: 14px;
    }


    .mail-input:focus {
        border-color: #2563eb;

        box-shadow:
            0 0 0 2px rgba(37, 99, 235, 0.08);
    }


    .mail-input::placeholder {
        color: #6b7280;
    }


    .mail-recipient-actions {
        flex: 0 0 auto;

        display: flex;
        align-items: center;

        gap: 2px;
    }


    .mail-small-button {
        min-width: 42px;
        min-height: 34px;

        padding: 4px 8px;

        border: 0;
        border-radius: 5px;

        background: transparent;

        color: #4b5563;

        font-size: 13px;
        font-weight: 600;

        cursor: pointer;
    }


    .mail-small-button:hover {
        background: #f1f3f4;
    }


    /*
     * --------------------------------------------------
     * CC / BCC
     * --------------------------------------------------
     */

    .mail-hidden-field {
        display: none;

        flex: 0 0 auto;

        padding: 6px 20px 0;
    }


    .mail-hidden-field.is-visible {
        display: block;
    }


    /*
     * --------------------------------------------------
     * SUBJECT
     * --------------------------------------------------
     */

    .mail-subject-field {
        flex: 0 0 auto;

        padding: 6px 20px 0;
    }


    /*
     * --------------------------------------------------
     * MAIN SCROLL AREA
     * --------------------------------------------------
     *
     * Message + toolbar + attachments all live here.
     */

    .mail-compose-scroll-area {
        flex: 1 1 auto;

        min-height: 0;

        overflow-y: auto;
        overflow-x: hidden;

        display: flex;
        flex-direction: column;

        scrollbar-width: thin;

        background: #ffffff;
    }


    /*
     * --------------------------------------------------
     * MESSAGE EDITOR
     * --------------------------------------------------
     */

    .mail-editor-section {
        flex: 0 0 auto;

        min-height: 360px;

        width: 100%;

        display: flex;
        flex-direction: column;

        box-sizing: border-box;

        background: #ffffff;
    }


    .mail-editor {
        width: 100%;

        min-height: 360px;

        padding: 16px 20px;

        box-sizing: border-box;

        border-top: 1px solid #e1e5ea;
        border-bottom: 1px solid #e1e5ea;

        outline: none;

        background: #ffffff;

        color: #202124;

        font-family: Arial, sans-serif;

        font-size: 15px;

        line-height: 1.6;

        overflow-y: auto;

        overflow-x: hidden;
    }


    .mail-editor:empty::before {
        content: attr(data-placeholder);

        color: #9ca3af;

        pointer-events: none;
    }


    .mail-editor:focus {
        outline: none;
    }


    .mail-editor img {
        max-width: 100%;
        height: auto;
    }


    .mail-editor a {
        color: #2563eb;
    }


    .mail-editor blockquote {
        margin: 10px 0;

        padding-left: 12px;

        border-left: 3px solid #d1d5db;

        color: #6b7280;
    }


    /*
     * Hidden textarea used by ASP.NET Core.
     */

    .mail-body-field {
        position: absolute;

        left: -99999px;
        top: -99999px;

        width: 1px;
        height: 1px;

        opacity: 0;

        pointer-events: none;
    }


    /*
     * --------------------------------------------------
     * TOOLBAR
     * --------------------------------------------------
     */

    .mail-toolbar {
        flex: 0 0 auto;

        width: 100%;

        min-height: 50px;

        display: flex;
        align-items: center;

        flex-wrap: nowrap;

        gap: 0;

        padding: 7px 10px;

        box-sizing: border-box;

        overflow-x: auto;
        overflow-y: hidden;

        border-bottom: 1px solid #dfe3e8;

        background: #eef3fb;

        scrollbar-width: thin;
    }


    .mail-toolbar-button {
        flex: 0 0 auto;

        min-width: 36px;
        height: 36px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        gap: 5px;

        padding: 5px 8px;

        border: 0;

        border-radius: 6px;

        background: transparent;

        color: #4b5563;

        font-family: inherit;

        font-size: 13px;

        font-weight: 500;

        white-space: nowrap;

        cursor: pointer;
    }


    .mail-toolbar-button:hover {
        background: #dfe7f3;

        color: #202124;
    }


    .mail-toolbar-button:active {
        background: #d5dfed;
    }


    .mail-toolbar-icon {
        display: inline-flex;

        align-items: center;
        justify-content: center;

        min-width: 20px;

        font-size: 17px;
    }


    .mail-toolbar-label {
        display: inline-block;
    }


    .tool-icon-bold {
        font-weight: 900;
    }


    .tool-icon-italic {
        font-style: italic;

        font-weight: 700;
    }


    .tool-icon-underline {
        font-weight: 700;

        text-decoration: underline;
    }


    .tool-icon-strike {
        font-weight: 700;

        text-decoration: line-through;
    }


    .tool-icon-font {
        font-family: Georgia, serif;

        font-weight: 700;
    }


    .tool-icon-font-size {
        font-weight: 700;
    }


    .tool-icon-color {
        font-weight: 900;

        text-decoration: underline;

        text-decoration-thickness: 3px;
    }


    .tool-icon-remove-format {
        font-weight: 700;

        text-decoration: line-through;
    }


    /*
     * --------------------------------------------------
     * ATTACHMENT AREA
     * --------------------------------------------------
     */

    .mail-attachments-section {
        flex: 0 0 auto;

        width: 100%;

        padding: 10px 14px 12px;

        box-sizing: border-box;

        background: #ffffff;

        border-bottom: 1px solid #e1e5ea;
    }


    .mail-attachments-title {
        margin-bottom: 8px;

        color: #374151;

        font-size: 13px;

        font-weight: 600;
    }


    /*
     * JavaScript places attachment cards
     * inside this container.
     */

    .mail-selected-attachments {
        width: 100%;

        display: none;

        flex-direction: column;

        flex-wrap: nowrap;

        align-items: stretch;

        gap: 8px;

        box-sizing: border-box;
    }


    .mail-selected-attachments.has-files {
        display: flex;
    }


    /*
     * Individual attachment card.
     */

    .mail-selected-file {
        width: 100%;

        min-height: 70px;

        display: flex;

        align-items: center;

        box-sizing: border-box;

        padding: 8px 12px;

        border: 1px solid #dfe3e8;

        border-radius: 8px;

        background: #ffffff;

        overflow: hidden;
    }


    /*
     * Image attachment.
     *
     * Important:
     * The whole image is visible.
     */

    .mail-selected-file-image-box {
        flex: 0 0 240px;

        width: 240px;
        height: 150px;

        display: flex;

        align-items: center;
        justify-content: center;

        overflow: hidden;

        background: #f8fafc;

        border: 1px solid #e5e7eb;

        border-radius: 8px;
    }


    .mail-selected-file-image {
        width: 100%;
        height: 100%;

        max-width: 100%;
        max-height: 100%;

        display: block;

        object-fit: contain;

        object-position: center;
    }


    /*
     * Non-image attachment icon.
     */

    .mail-selected-file-icon-box {
        flex: 0 0 72px;

        width: 72px;
        height: 72px;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 38px;
    }


    .mail-selected-file-icon {
        display: inline-flex;

        align-items: center;
        justify-content: center;
    }


    .mail-selected-file-info {
        flex: 1 1 auto;

        min-width: 0;

        margin-left: 12px;

        padding-right: 42px;

        display: flex;

        flex-direction: column;

        justify-content: center;
    }


    .mail-selected-file-name {
        max-width: 100%;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;

        color: #1f2937;

        font-size: 14px;
    }


    .mail-selected-file-size {
        margin-top: 4px;

        color: #6b7280;

        font-size: 12px;
    }


    .mail-selected-file-remove {
        position: absolute;

        right: 12px;

        top: 50%;

        transform: translateY(-50%);

        width: 28px;
        height: 28px;

        display: flex;

        align-items: center;
        justify-content: center;

        padding: 0;

        border: 0;

        border-radius: 50%;

        background: transparent;

        color: #6b7280;

        font-size: 16px;

        cursor: pointer;
    }


    .mail-selected-file-remove:hover {
        background: #f1f3f4;

        color: #d93025;
    }


    /*
     * Hidden compatibility list.
     */

    .mail-attachment-empty {
        display: none;
    }


    /*
     * --------------------------------------------------
     * EXISTING DRAFT ATTACHMENTS
     * --------------------------------------------------
     */

    .mail-existing-attachments {
        flex: 0 0 auto;

        margin: 0 0 10px;

        padding: 8px 10px;

        border: 1px solid #e1e5ea;

        border-radius: 8px;

        background: #fafbfc;
    }


    .mail-existing-title {
        margin-bottom: 5px;

        color: #202124;

        font-size: 12px;

        font-weight: 600;
    }


    .mail-existing-attachment {
        display: flex;

        align-items: center;

        gap: 8px;

        padding: 5px 0;

        color: #2563eb;

        text-decoration: none;
    }


    .mail-existing-name {
        flex: 1;

        min-width: 0;

        overflow: hidden;

        text-overflow: ellipsis;

        white-space: nowrap;
    }


    .mail-existing-size {
        color: #6b7280;

        font-size: 11px;
    }


    /*
     * --------------------------------------------------
     * POPOVERS
     * --------------------------------------------------
     */

    .mail-popover {
        position: fixed;

        z-index: 99999;

        min-width: 160px;

        padding: 8px;

        border: 1px solid #d9dde3;

        border-radius: 8px;

        background: #ffffff;

        box-shadow:
            0 8px 25px rgba(0, 0, 0, 0.14);
    }


    .mail-popover[hidden] {
        display: none !important;
    }


    .mail-popover button {
        display: block;

        width: 100%;

        margin-bottom: 5px;

        padding: 8px 10px;

        border: 1px solid #e0e3e7;

        border-radius: 6px;

        background: #ffffff;

        color: #374151;

        font-family: inherit;

        font-size: 13px;

        text-align: left;

        cursor: pointer;
    }


    .mail-popover button:last-child {
        margin-bottom: 0;
    }


    .mail-popover button:hover {
        background: #f3f4f6;
    }


    .mail-color-popover {
        display: flex;

        flex-wrap: wrap;

        gap: 6px;

        min-width: 150px;
    }


    .mail-color-popover button {
        width: 28px;
        height: 28px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        margin: 0;

        padding: 0;

        border-radius: 50%;

        text-align: center;

        font-size: 18px;
    }


    /*
     * --------------------------------------------------
     * FOOTER
     * --------------------------------------------------
     */

    .mail-compose-footer {
        flex: 0 0 auto;

        min-height: 64px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: 10px;

        padding: 8px 20px;

        box-sizing: border-box;

        background: #ffffff;

        border-top: 1px solid #e1e5ea;
    }


    .mail-footer-left {
        display: flex;

        align-items: center;

        gap: 8px;
    }


    .mail-send-button,
    .mail-draft-button,
    .mail-cancel-button {
        min-height: 40px;

        display: inline-flex;

        align-items: center;

        justify-content: center;

        padding: 8px 16px;

        border-radius: 20px;

        font-family: inherit;

        font-size: 13px;

        font-weight: 600;

        text-decoration: none;

        cursor: pointer;
    }


    .mail-send-button {
        border: 1px solid #0b57d0;

        background: #0b57d0;

        color: #ffffff;
    }


    .mail-send-button:hover {
        background: #0842a0;
    }


    .mail-draft-button,
    .mail-cancel-button {
        border: 1px solid #d1d5db;

        background: #ffffff;

        color: #374151;
    }


    .mail-draft-button:hover,
    .mail-cancel-button:hover {
        background: #f3f4f6;
    }


    .mail-delete-button {
        width: 38px;
        height: 38px;

        border: 0;

        border-radius: 50%;

        background: transparent;

        color: #5f6368;

        cursor: pointer;
    }


    .mail-delete-button:hover {
        background: #f1f3f4;
    }


    /*
     * --------------------------------------------------
     * VALIDATION
     * --------------------------------------------------
     */

    .mail-field-error {
        display: block;

        margin-top: 3px;

        color: #dc2626;

        font-size: 12px;
    }


    /*
     * --------------------------------------------------
     * MOBILE
     * --------------------------------------------------
     */

    @@media (max-width: 900px) {

        .mail-compose-page {
            height: calc(100vh - 60px);

            padding: 0;
        }


        .mail-compose-card {
            max-width: none;

            border-radius: 0;
        }


        .mail-recipient-row {
            padding-left: 12px;
            padding-right: 12px;
        }


        .mail-hidden-field {
            padding-left: 12px;
            padding-right: 12px;
        }


        .mail-subject-field {
            padding-left: 12px;
            padding-right: 12px;
        }


        .mail-editor {
            padding-left: 14px;
            padding-right: 14px;
        }


        .mail-attachments-section {
            padding-left: 10px;
            padding-right: 10px;
        }


        .mail-compose-footer {
            padding-left: 12px;
            padding-right: 12px;
        }

    }


    @@media (max-width: 650px) {

        .mail-toolbar-label {
            display: none;
        }


        .mail-toolbar-button {
            min-width: 34px;

            padding-left: 6px;
            padding-right: 6px;
        }


        .mail-selected-file-image-box {
            flex-basis: 150px;

            width: 150px;

            height: 100px;
        }


        .mail-draft-button,
        .mail-cancel-button {
            display: none;
        }

    }

</style>


<div class="mail-compose-page">

    <div class="mail-compose-card">


        <!-- Header -->

        <div class="mail-compose-header">

            <h1>
                New Message
            </h1>

            <a asp-controller="Mail"
               asp-action="Inbox"
               class="mail-compose-close"
               title="Close">

                ×

            </a>

        </div>


        <!-- Form -->

        <form asp-controller="Mail"
              asp-action="Compose"
              method="post"
              enctype="multipart/form-data"
              id="mailComposeForm"
              class="mail-compose-form">

            @Html.AntiForgeryToken()


            <input asp-for="DraftId"
                   type="hidden" />


            <input asp-for="ReplyToMessageId"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="mail-validation-summary">
            </div>


            <!-- Recipients -->

            <div class="mail-recipient-row">

                <div class="mail-field mail-field-main">

                    <input asp-for="RecipientEmail"
                           class="mail-input"
                           list="mailRecipients"
                           autocomplete="off"
                           placeholder="Recipients" />


                    <datalist id="mailRecipients">

                        @if (Model.Recipients != null)
                        {
                            foreach (var recipient
                                in Model.Recipients)
                            {
                                <option value="@recipient.Email">
                                    @recipient.Name
                                </option>
                            }
                        }

                    </datalist>


                    <span asp-validation-for="RecipientEmail"
                          class="mail-field-error">
                    </span>

                </div>


                <div class="mail-recipient-actions">

                    <button type="button"
                            id="showCcButton"
                            class="mail-small-button">

                        Cc

                    </button>


                    <button type="button"
                            id="showBccButton"
                            class="mail-small-button">

                        Bcc

                    </button>

                </div>

            </div>


            <!-- CC -->

            <div id="ccField"
                 class="mail-hidden-field">

                <input asp-for="CcEmails"
                       class="mail-input"
                       placeholder="Cc" />


                <span asp-validation-for="CcEmails"
                      class="mail-field-error">
                </span>

            </div>


            <!-- BCC -->

            <div id="bccField"
                 class="mail-hidden-field">

                <input asp-for="BccEmails"
                       class="mail-input"
                       placeholder="Bcc" />


                <span asp-validation-for="BccEmails"
                      class="mail-field-error">
                </span>

            </div>


            <!-- Subject -->

            <div class="mail-subject-field">

                <input asp-for="Subject"
                       class="mail-input"
                       maxlength="255"
                       placeholder="Subject" />


                <span asp-validation-for="Subject"
                      class="mail-field-error">
                </span>

            </div>


            <!--
                 Everything below this point
                 scrolls as one compose area.
            -->

            <div class="mail-compose-scroll-area">


                <!-- Message -->

                <div class="mail-editor-section">

                    <div id="mailEditor"
                         class="mail-editor"
                         contenteditable="true"
                         spellcheck="true"
                         role="textbox"
                         aria-multiline="true"
                         data-placeholder="Write your message...">@Html.Raw(Model.Body)</div>


                    <textarea asp-for="Body"
                              id="mailBodyField"
                              class="mail-body-field"></textarea>


                    <span asp-validation-for="Body"
                          class="mail-field-error">
                    </span>

                </div>


                <!-- Toolbar -->

                <div class="mail-toolbar"
                     id="mailComposeToolbar">

                    @if (Model.Tools != null &&
                         Model.Tools.Count > 0)
                    {
                        foreach (var tool
                            in Model.Tools
                                .Where(x => x.IsEnabled)
                                .OrderBy(x => x.DisplayOrder))
                        {
                            string icon =
                                tool.ToolKey switch
                                {
                                    "undo" =>
                                        "↶",

                                    "redo" =>
                                        "↷",

                                    "font" =>
                                        "A",

                                    "fontSize" =>
                                        "A↕",

                                    "bold" =>
                                        "B",

                                    "italic" =>
                                        "I",

                                    "underline" =>
                                        "U",

                                    "textColor" =>
                                        "A",

                                    "align" =>
                                        "☰",

                                    "orderedList" =>
                                        "1.",

                                    "unorderedList" =>
                                        "•",

                                    "outdent" =>
                                        "⇤",

                                    "indent" =>
                                        "⇥",

                                    "quote" =>
                                        "❝",

                                    "strike" =>
                                        "S",

                                    "removeFormat" =>
                                        "Tx",

                                    "attachment" =>
                                        "📎",

                                    "link" =>
                                        "🔗",

                                    "emoji" =>
                                        "😊",

                                    "image" =>
                                        "🖼",

                                    "signature" =>
                                        "✍",

                                    "confidential" =>
                                        "🔒",

                                    _ =>
                                        "•"
                                };


                            string iconClass =
                                tool.ToolKey switch
                                {
                                    "font" =>
                                        "tool-icon-font",

                                    "fontSize" =>
                                        "tool-icon-font-size",

                                    "bold" =>
                                        "tool-icon-bold",

                                    "italic" =>
                                        "tool-icon-italic",

                                    "underline" =>
                                        "tool-icon-underline",

                                    "textColor" =>
                                        "tool-icon-color",

                                    "strike" =>
                                        "tool-icon-strike",

                                    "removeFormat" =>
                                        "tool-icon-remove-format",

                                    _ =>
                                        ""
                                };


                            <button type="button"
                                    class="mail-toolbar-button"
                                    data-tool="@tool.ToolKey"
                                    title="@tool.DisplayName"
                                    aria-label="@tool.DisplayName">

                                <span class="mail-toolbar-icon @iconClass">
                                    @icon
                                </span>

                                <span class="mail-toolbar-label">
                                    @tool.DisplayName
                                </span>

                            </button>
                        }
                    }

                </div>


                <!-- Font popover -->

                <div id="fontPopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-font="Arial">
                        Arial
                    </button>

                    <button type="button"
                            data-font="Verdana">
                        Verdana
                    </button>

                    <button type="button"
                            data-font="Georgia">
                        Georgia
                    </button>

                    <button type="button"
                            data-font="Times New Roman">
                        Times New Roman
                    </button>

                </div>


                <!-- Font size popover -->

                <div id="fontSizePopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-size="1">
                        Small
                    </button>

                    <button type="button"
                            data-size="3">
                        Normal
                    </button>

                    <button type="button"
                            data-size="5">
                        Large
                    </button>

                    <button type="button"
                            data-size="7">
                        Huge
                    </button>

                </div>


                <!-- Color popover -->

                <div id="colorPopover"
                     class="mail-popover mail-color-popover"
                     hidden>

                    <button type="button"
                            data-color="#000000"
                            style="color:#000000;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#d32f2f"
                            style="color:#d32f2f;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#1976d2"
                            style="color:#1976d2;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#388e3c"
                            style="color:#388e3c;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#7b1fa2"
                            style="color:#7b1fa2;">
                        ●
                    </button>

                    <button type="button"
                            data-color="#f57c00"
                            style="color:#f57c00;">
                        ●
                    </button>

                </div>


                <!-- Alignment popover -->

                <div id="alignPopover"
                     class="mail-popover"
                     hidden>

                    <button type="button"
                            data-align="justifyLeft">
                        ← Left
                    </button>

                    <button type="button"
                            data-align="justifyCenter">
                        ↔ Center
                    </button>

                    <button type="button"
                            data-align="justifyRight">
                        → Right
                    </button>

                    <button type="button"
                            data-align="justifyFull">
                        ☰ Justify
                    </button>

                </div>


                <!--
                     Attachments are deliberately BELOW
                     the message editor and toolbar.
                -->

                <div class="mail-attachments-section">

                    <div class="mail-attachments-title">
                        Attachments
                    </div>


                    <div id="mailSelectedAttachments"
                         class="mail-selected-attachments">
                    </div>


                    <!--
                         This is the real multipart input.
                         The toolbar opens it.
                    -->

                    <input type="file"
                           id="mailAttachmentInput"
                           name="Attachments"
                           multiple
                           hidden
                           accept="@allowedExtensions" />


                    <!-- Compatibility container -->

                    <div id="mailAttachmentList"
                         class="mail-attachment-empty">
                    </div>

                </div>


                <!-- Existing draft attachments -->

                @if (Model.ExistingAttachments != null &&
                     Model.ExistingAttachments.Count > 0)
                {
                    <div class="mail-existing-attachments">

                        <div class="mail-existing-title">
                            Existing attachments
                        </div>


                        @foreach (
                            var attachment
                            in Model.ExistingAttachments)
                        {
                            <a asp-controller="Mail"
                               asp-action="DownloadAttachment"
                               asp-route-id="@attachment.Id"
                               class="mail-existing-attachment">

                                <span>
                                    📎
                                </span>

                                <span class="mail-existing-name">
                                    @attachment.OriginalFileName
                                </span>

                                <span class="mail-existing-size">
                                    @FormatFileSize(
                                        attachment.FileSize)
                                </span>

                            </a>
                        }

                    </div>
                }

            </div>


            <!-- Footer -->

            <div class="mail-compose-footer">

                <div class="mail-footer-left">

                    @if (Model.DraftId.HasValue)
                    {
                        <button type="submit"
                                formaction="@Url.Action(
                                    "SendDraft",
                                    "Mail",
                                    new
                                    {
                                        id = Model.DraftId.Value
                                    })"
                                class="mail-send-button">

                            Send

                        </button>
                    }
                    else
                    {
                        <button type="submit"
                                class="mail-send-button">

                            Send

                        </button>
                    }


                    <button type="submit"
                            formaction="@Url.Action(
                                "SaveDraft",
                                "Mail")"
                            class="mail-draft-button">

                        Save Draft

                    </button>


                    <a asp-controller="Mail"
                       asp-action="Inbox"
                       class="mail-cancel-button">

                        Cancel

                    </a>

                </div>


                <button type="button"
                        class="mail-delete-button"
                        title="Discard draft"
                        onclick="
                            window.location.href='@Url.Action(
                                "Inbox",
                                "Mail")';
                        ">

                    🗑

                </button>

            </div>

        </form>

    </div>

</div>


@functions
{
    private static string FormatFileSize(
        long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        if (
            bytes <
            1024 * 1024)
        {
            return
                $"{bytes / 1024d:0.##} KB";
        }

        if (
            bytes <
            1024 *
            1024 *
            1024)
        {
            return
                $"{bytes / 1024d / 1024d:0.##} MB";
        }

        return
            $"{bytes / 1024d / 1024d / 1024d:0.##} GB";
    }
}


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <script>

        window.mailComposeConfig = {
            tools:
                @Html.Raw(serializedTools),

            signatures:
                @Html.Raw(serializedSignatures)
        };

    </script>


    <script src="~/js/mail-composer.js"
            asp-append-version="true"></script>


    <script src="~/js/mail-attachments.js"
            asp-append-version="true"></script>
}