@model List<UserManagementMvc.Models.MailMessage>

@{
    ViewData["Title"] = "Drafts";
}

<div class="mail-page">

    <div class="mail-page-header">
        <div>
            <h2>Drafts</h2>
            <p>Messages saved for later.</p>
        </div>

        <a asp-controller="Mail"
           asp-action="Compose"
           class="mail-primary-button">
            + Compose
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="mail-empty">
            <div class="mail-empty-icon">📝</div>
            <h4>No drafts</h4>
            <p>Your saved messages will appear here.</p>
        </div>
    }
    else
    {
        <div class="mail-list">

            @foreach (var draft in Model)
            {
                <div class="mail-row">

                    <div class="mail-draft-icon">
                        📝
                    </div>

                    <a asp-controller="Mail"
                       asp-action="EditDraft"
                       asp-route-id="@draft.Id"
                       class="mail-row-content">

                        <div class="mail-row-main">

                            <div class="mail-row-sender">
                                Draft
                            </div>

                            <div class="mail-row-subject">
                                @(string.IsNullOrWhiteSpace(draft.Subject)
                                    ? "(No subject)"
                                    : draft.Subject)
                            </div>

                            <div class="mail-row-preview">
                                @(string.IsNullOrWhiteSpace(draft.Body)
                                    ? "Empty draft"
                                    : draft.Body)
                            </div>

                        </div>

                        <div class="mail-row-date">
                            @(draft.DraftSavedAt?.ToString("dd MMM yyyy") ?? "")
                        </div>

                    </a>

                    <div class="mail-row-actions">

                        <a asp-controller="Mail"
                           asp-action="EditDraft"
                           asp-route-id="@draft.Id"
                           class="mail-action-button">
                            Open
                        </a>

                        <a asp-controller="Mail"
                           asp-action="DeleteDraft"
                           asp-route-id="@draft.Id"
                           class="mail-action-button danger">
                            Delete
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>