@model List<UserManagementMvc.ViewModels.MailDetailsViewModel>

@using System.Text.RegularExpressions
@using System.Net

@{
    ViewData["Title"] = "Inbox";

    string GetPreview(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        string text =
            Regex.Replace(
                html,
                "<.*?>",
                " ");

        text =
            WebUtility.HtmlDecode(
                text);

        text =
            Regex.Replace(
                text,
                @"\s+",
                " ");

        return text.Trim();
    }
}

<div class="mail-page">

    <div class="mail-page-header">

        <div>
            <h2>Inbox</h2>

            <p>
                Your received messages.
            </p>
        </div>

        <a asp-controller="Mail"
           asp-action="Compose"
           class="mail-primary-button">
            + Compose
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="mail-list">

        @if (Model == null ||
             Model.Count == 0)
        {
            <div class="mail-empty">

                <div class="mail-empty-icon">
                    ✉
                </div>

                <h4>Your inbox is empty</h4>

                <p>
                    New messages will appear here.
                </p>

            </div>
        }
        else
        {
            @foreach (var mail in Model)
            {
                bool isServerMessage =
                    mail.ServerMessage != null;

                string messageId =
                    isServerMessage
                        ? mail.ServerMessage!.Id
                        : mail.DatabaseMessage!.Id.ToString();

                string sender =
                    isServerMessage
                        ? mail.ServerMessage!.SenderEmail
                        : mail.DatabaseMessage!.SenderEmail;

                string subject =
                    isServerMessage
                        ? mail.ServerMessage!.Subject
                        : mail.DatabaseMessage!.Subject;

                string body =
                    isServerMessage
                        ? mail.ServerMessage!.Body
                        : mail.DatabaseMessage!.Body;

                bool isRead =
                    isServerMessage
                        ? mail.ServerMessage!.IsRead
                        : mail.DatabaseMessage!.IsRead;

                bool isStarred =
                    isServerMessage
                        ? mail.ServerMessage!.IsStarred
                        : mail.DatabaseMessage!.IsStarred;

                DateTime sentAt =
                    isServerMessage
                        ? mail.ServerMessage!.SentAt
                        : mail.DatabaseMessage!.SentAt;

                string messageType =
                    isServerMessage
                        ? "External"
                        : (
                            string.Equals(
                                mail.DatabaseMessage!.MessageType,
                                "External",
                                StringComparison.OrdinalIgnoreCase)
                                ? "External"
                                : "Internal"
                        );

                int attachmentCount =
                    isServerMessage
                        ? mail.ServerMessage!.Attachments.Count
                        : mail.DatabaseMessage!.Attachments.Count;

                <div class="mail-row @(isRead ? "" : "mail-unread")">

                    <div class="mail-star">

                        <form asp-controller="Mail"
                              asp-action="ToggleStarFromList"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@messageId" />

                            <input type="hidden"
                                   name="returnAction"
                                   value="Inbox" />

                            <button type="submit"
                                    class="mail-star-button @(isStarred ? "active" : "")"
                                    title="@(isStarred ? "Remove star" : "Star")">

                                @(isStarred ? "★" : "☆")

                            </button>

                        </form>

                    </div>

                    <a asp-controller="Mail"
                       asp-action="Details"
                       asp-route-id="@messageId"
                       class="mail-row-content">

                        <div class="mail-row-main">

                            <div class="mail-row-sender">

                                <span>
                                    @sender
                                </span>

                                <span class="mail-type-badge">
                                    @messageType
                                </span>

                            </div>

                            <div class="mail-row-subject">

                                @(string.IsNullOrWhiteSpace(subject)
                                    ? "(No subject)"
                                    : subject)

                                @if (attachmentCount > 0)
                                {
                                    <span class="mail-attachment-indicator"
                                          title="This message has attachments">

                                        📎 @attachmentCount

                                    </span>
                                }

                            </div>

                            <div class="mail-row-preview">

                                @GetPreview(body)

                            </div>

                        </div>

                        <div class="mail-row-date">

                            @(sentAt.Date == DateTime.Today
                                ? sentAt.ToString("h:mm tt")
                                : sentAt.ToString("dd MMM"))

                        </div>

                    </a>

                    <div class="mail-row-actions">

                        <a asp-controller="Mail"
                           asp-action="DeleteInbox"
                           asp-route-id="@messageId"
                           class="mail-action-button danger">

                            Delete

                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>