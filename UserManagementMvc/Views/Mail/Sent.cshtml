@model List<UserManagementMvc.Models.MailMessage>

@using System.Text.RegularExpressions
@using System.Net

@{
    ViewData["Title"] = "Sent";

    string GetPreview(string? html)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return string.Empty;
        }

        string text = Regex.Replace(
            html,
            "<.*?>",
            " ");

        text = WebUtility.HtmlDecode(text);

        text = Regex.Replace(
            text,
            @"\s+",
            " ");

        return text.Trim();
    }
}

<div class="mail-page">

    <div class="mail-page-header">

        <div>
            <h2>Sent</h2>
            <p>Messages you have sent.</p>
        </div>

        <a asp-controller="Mail"
           asp-action="Compose"
           class="mail-primary-button">
            + Compose
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="mail-list">

        @if (Model == null || Model.Count == 0)
        {
            <div class="mail-empty">

                <div class="mail-empty-icon">
                    ↗
                </div>

                <h4>No sent messages</h4>

                <p>
                    Messages you send will appear here.
                </p>

            </div>
        }
        else
        {
            @foreach (var mail in Model)
            {
                <div class="mail-row">

                    <div class="mail-star">

                        <form asp-controller="Mail"
                              asp-action="ToggleStarFromList"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@mail.Id" />

                            <input type="hidden"
                                   name="returnAction"
                                   value="Sent" />

                            <button type="submit"
                                    class="mail-star-button @(mail.IsStarred ? "active" : "")"
                                    title="@(mail.IsStarred ? "Remove star" : "Star")">

                                @(mail.IsStarred ? "★" : "☆")

                            </button>

                        </form>

                    </div>

                    <a asp-controller="Mail"
                       asp-action="Details"
                       asp-route-id="@mail.Id"
                       class="mail-row-content">

                        <div class="mail-row-main">

                            <div class="mail-row-sender">
                                To: @mail.RecipientEmail
                            </div>

                            <div class="mail-row-subject">

                                @(string.IsNullOrWhiteSpace(mail.Subject)
                                    ? "(No subject)"
                                    : mail.Subject)

                                @if (mail.Attachments != null &&
                                     mail.Attachments.Count > 0)
                                {
                                    <span class="mail-attachment-indicator"
                                          title="This message has attachments">
                                        📎 @mail.Attachments.Count
                                    </span>
                                }

                            </div>

                            <div class="mail-row-preview">
                                @GetPreview(mail.Body)
                            </div>

                        </div>

                        <div class="mail-row-date">
                            @mail.SentAt.ToString("dd MMM yyyy")
                        </div>

                    </a>

                    <div class="mail-row-actions">

                        <a asp-controller="Mail"
                           asp-action="DeleteSent"
                           asp-route-id="@mail.Id"
                           class="mail-action-button danger">
                            Delete
                        </a>

                    </div>

                </div>
            }
        }

    </div>

</div>