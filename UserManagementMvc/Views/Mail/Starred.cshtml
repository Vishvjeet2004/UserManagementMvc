@model List<UserManagementMvc.Models.MailMessage>

@{
    ViewData["Title"] = "Starred";
}

<div class="mail-page">

    <div class="mail-page-header">
        <div>
            <h2>Starred</h2>
            <p>Important messages saved for quick access.</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="mail-empty">
            <div class="mail-empty-icon">☆</div>
            <h4>No starred messages</h4>
            <p>Star important messages and they will appear here.</p>
        </div>
    }
    else
    {
        <div class="mail-list">

            @foreach (var mail in Model)
            {
                <div class="mail-row @(mail.IsRead ? "" : "mail-unread")">

                    <div class="mail-star">
                        <form asp-controller="Mail"
                              asp-action="ToggleStarFromList"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@mail.Id" />

                            <input type="hidden"
                                   name="returnAction"
                                   value="Starred" />

                            <button type="submit"
                                    class="mail-star-button active">
                                ★
                            </button>
                        </form>
                    </div>

                    <a asp-controller="Mail"
                       asp-action="Details"
                       asp-route-id="@mail.Id"
                       class="mail-row-content">

                        <div class="mail-row-main">

                            <div class="mail-row-sender">
                                @(mail.RecipientUserId != null
                                    ? mail.RecipientEmail
                                    : mail.SenderEmail)
                            </div>

                            <div class="mail-row-subject">
                                @mail.Subject
                            </div>

                            <div class="mail-row-preview">
                                @mail.Body
                            </div>

                        </div>

                        <div class="mail-row-date">
                            @mail.SentAt.ToString("dd MMM yyyy")
                        </div>

                    </a>

                </div>
            }

        </div>
    }

</div>