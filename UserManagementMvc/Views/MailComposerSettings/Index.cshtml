@model List<UserManagementMvc.Models.MailComposerTool>

@{
    ViewData["Title"] = "Mail Composer Settings";

    var signatures =
        ViewBag.Signatures
        as List<UserManagementMvc.Models.MailSignature>
        ?? new List<UserManagementMvc.Models.MailSignature>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>✉️ Mail Composer Settings</h2>
            <p class="text-muted mb-0">
                Control which compose tools users can access.
            </p>
        </div>

        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Composer Tools</strong>
        </div>

        <div class="card-body">

            <form asp-action="SaveTools"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>
                                <th>Tool</th>
                                <th>Enabled</th>
                                <th>Order</th>
                            </tr>

                        </thead>

                        <tbody>

                            @for (int i = 0;
                                  i < Model.Count;
                                  i++)
                            {
                                <tr>

                                    <td>

                                        @Model[i].DisplayName

                                        <input type="hidden"
                                               asp-for="@Model[i].Id" />

                                        <input type="hidden"
                                               asp-for="@Model[i].ToolKey" />

                                        <input type="hidden"
                                               asp-for="@Model[i].DisplayName" />

                                    </td>

                                    <td>

                                        <input asp-for="@Model[i].IsEnabled"
                                               class="form-check-input" />

                                    </td>

                                    <td style="max-width:140px;">

                                        <input asp-for="@Model[i].DisplayOrder"
                                               class="form-control"
                                               type="number"
                                               min="1" />

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Tool Settings
                </button>

            </form>

        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Add Signature</strong>
        </div>

        <div class="card-body">

            <form asp-action="AddSignature"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        Signature Name
                    </label>

                    <input type="text"
                           name="name"
                           class="form-control"
                           maxlength="100"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Signature HTML
                    </label>

                    <textarea name="signatureHtml"
                              class="form-control"
                              rows="6"
                              placeholder="Regards,<br><strong>Your Name</strong>"
                              required></textarea>

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Add Signature
                </button>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <strong>Existing Signatures</strong>
        </div>

        <div class="card-body">

            @if (signatures.Count == 0)
            {
                <div class="text-muted">
                    No signatures available.
                </div>
            }
            else
            {
                foreach (var signature
                         in signatures)
                {
                    <div class="border rounded p-3 mb-3">

                        <div class="d-flex justify-content-between">

                            <div>
                                <strong>
                                    @signature.Name
                                </strong>

                                @if (signature.IsDefault)
                                {
                                    <span class="badge bg-primary ms-2">
                                        Default
                                    </span>
                                }

                                @if (!signature.IsActive)
                                {
                                    <span class="badge bg-secondary ms-2">
                                        Inactive
                                    </span>
                                }
                            </div>

                            <div class="d-flex gap-2">

                                @if (!signature.IsDefault &&
                                     signature.IsActive)
                                {
                                    <form asp-action="SetDefaultSignature"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@signature.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-primary">
                                            Make Default
                                        </button>

                                    </form>
                                }

                                <form asp-action="ToggleSignature"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@signature.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary">

                                        @(signature.IsActive
                                            ? "Disable"
                                            : "Enable")

                                    </button>

                                </form>

                                <form asp-action="DeleteSignature"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@signature.Id" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>

                        <div class="mt-3 p-3 bg-light rounded">

                            @Html.Raw(signature.SignatureHtml)

                        </div>

                    </div>
                }
            }

        </div>

    </div>

</div>