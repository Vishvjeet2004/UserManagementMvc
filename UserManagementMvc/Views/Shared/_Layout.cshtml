@using Microsoft.AspNetCore.Http

@{
    // Read the current session state.
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;

    // Detect whether the current page belongs to the Mail controller.
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var isMailPage =
        string.Equals(
            currentController,
            "Mail",
            StringComparison.OrdinalIgnoreCase);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <!-- Configure responsive page scaling. -->
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - UserManagementMvc
    </title>

    <script type="importmap"></script>

    <!-- Load Bootstrap styles. -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Load the main project styles. -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Load Messenger styles. -->
    <link rel="stylesheet"
          href="~/css/messenger.css"
          asp-append-version="true" />

    <!-- Load the floating Mail Messenger styles. -->
    @if (isMailPage)
    {
        <link rel="stylesheet"
              href="~/css/mail-messenger-floating.css"
              asp-append-version="true" />
    }

    <!-- Load generated project styles. -->
    <link rel="stylesheet"
          href="~/UserManagementMvc.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- Render the main navigation bar. -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Render the application brand link. -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    UserManagementMvc
                </a>

                <!-- Render the mobile navigation toggle. -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Render the primary navigation links. -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Render the Home navigation link. -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <!-- Render public navigation links. -->
                        @if (!isLoggedIn)
                        {
                        }
                        else
                        {
                        }

                        <!-- Render the Privacy navigation link. -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <!-- Render the Help navigation link. -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Help">
                                Help
                            </a>
                        </li>

                    </ul>

                    <!-- Render authenticated user navigation links. -->
                    <ul class="navbar-nav">

                        @if (isLoggedIn)
                        {
                            <!-- Render the Messenger navigation link. -->
                            <li class="nav-item">
                                <a class="nav-link text-success"
                                   asp-controller="Messenger"
                                   asp-action="Index">
                                    💬 Messenger
                                </a>
                            </li>

                            <!-- Render the Mail navigation link. -->
                            <li class="nav-item">
                                <a class="nav-link text-primary"
                                   asp-controller="Mail"
                                   asp-action="Inbox">
                                    ✉ Mail
                                </a>
                            </li>

                            <!-- Render the Logout navigation link. -->
                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!-- Render the current page content. -->
    <div class="container">
        <main role="main" class="pb-3">

            @RenderBody()

        </main>
    </div>

    <!-- Render the floating Messenger only on Mail pages. -->
    @if (isMailPage && isLoggedIn)
    {
        <partial name="_MailMessengerFloating" />
    }

    <!-- Render the application footer. -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - UserManagementMvc
        </div>
    </footer>

    <!-- Load jQuery. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Load Bootstrap JavaScript. -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Load the main project JavaScript. -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Load the floating Mail Messenger JavaScript. -->
    @if (isMailPage && isLoggedIn)
    {
        <script src="~/js/mail-messenger-floating.js"
                asp-append-version="true"></script>
    }

    <!-- Render page-specific scripts. -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>