@using Microsoft.AspNetCore.Http

@{
    /*
        Session se logged-in user ki details le rahe hain.
        Agar UserId session me hai, to user logged in maana jayega.
    */
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var isLoggedIn = Context.Session.GetInt32("UserId") != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <!-- Responsive design ke liye viewport -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - UserManagementMvc</title>

    <script type="importmap"></script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" 
        href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Project CSS files -->
    <link rel="stylesheet" 
        href="~/css/site.css" 
        asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/messenger.css"
          asp-append-version="true" />

    <link rel="stylesheet" 
        href="~/UserManagementMvc.styles.css" 
        asp-append-version="true" />

  
</head>

<body>

    <!-- 
         Navbar Section
         -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <!-- Website Brand / Home Link -->
                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    UserManagementMvc
                </a>



                <!-- Mobile responsive navbar button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- 
                         Left Side Navbar Links
                         -->
                    <ul class="navbar-nav flex-grow-1">

                        <!-- Home Link -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (!isLoggedIn)
                        {    
                        }
                        else
                        {
                                                 }

                        <!-- Privacy Link -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Help">
                                Help
                            </a>
                        </li>

                    </ul>

                    <!--
                         Right Side Navbar Links
                         -->
                    <ul class="navbar-nav">

                     
                        @if (isLoggedIn)
                        {

                            <!-- Messenger Link -->
                            <li class="nav-item">
                                <a class="nav-link text-success"
                                   asp-controller="Messenger"
                                   asp-action="Index">
                                    💬 Messenger
                                </a>
                            </li>

                      

                            <!-- Mail Link -->
                            <li class="nav-item">
                                <a class="nav-link text-primary"
                                   asp-controller="Mail"
                                   asp-action="Inbox">
                                    ✉ Mail
                                </a>
                            </li>

                         

                            <!-- Logout Link -->
                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-controller="Auth"
                                   asp-action="Logout">
                                    Logout
                                </a>


                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <!--
         Main Body Section
         Isme har page ka content render hota hai
        -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer Section
         -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - UserManagementMvc
        </div>
    </footer>

    <!--
         JavaScript Files
         Bootstrap bundle dropdown ke liye important hai
        -->
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap JS Bundle: dropdown, modal, navbar toggle ke liye required -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Project custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Page-specific scripts yahan render honge -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>