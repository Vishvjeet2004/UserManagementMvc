@model List<UserManagementMvc.Models.Sitecontentsection>

@{
    ViewData["Title"] = ViewBag.PageDisplayName;

    var pageName = ViewBag.PageName as string ?? "Privacy";
    var pageDisplayName = ViewBag.PageDisplayName as string ?? "Sections";
    var itemName = ViewBag.ItemName as string ?? "Section";
}

<h2>Manage @pageDisplayName</h2>

<p class="text-muted">
    SuperAdmin can add, edit, hide, show and delete @pageDisplayName from here.
</p>

<a asp-controller="Dashboard"
   asp-action="Index"
   class="btn btn-secondary mb-3">
    Back to Dashboard
</a>

<a asp-action="Create"
   asp-route-pageName="@pageName"
   class="btn btn-success mb-3">
    Add New @itemName
</a>

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th style="width:80px;">Order</th>
            <th style="width:240px;">Title</th>
            <th>Description</th>
            <th style="width:100px;">Status</th>
            <th style="width:230px;">Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DisplayOrder</td>

                <td>
                    <b>@item.SectionTitle</b>
                </td>

                <td>
                    <div style="white-space:pre-line; max-width:650px;">
                        @item.SectionContent
                    </div>
                </td>

                <td>
                    @if (item.IsActive == true)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm">
                        Edit
                    </a>

                    <a asp-action="ToggleStatus"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Active / Inactive
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this item?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>